# APP
APP_ENV=development
KIBA_PUBLIC_BASE_URL=http://localhost:14200
KIBA_TRUSTED_HOSTS=localhost,127.0.0.1

# DATABASE — local Docker Compose values only.
KIBA_POSTGRES_DB=kiba
KIBA_POSTGRES_USER=kiba
KIBA_POSTGRES_PASSWORD=change-me-for-nonlocal-use

# AUTH
KIBA_AUTH_COOKIE_SECURE=false
KIBA_AUTH_SESSION_DAYS=30
KIBA_AUTH_SESSION_IDLE_DAYS=14
KIBA_AUTH_SESSION_TOUCH_MINUTES=15

# SECURITY
KIBA_CSRF_TRUSTED_ORIGINS=http://localhost:14200,http://127.0.0.1:14200
KIBA_AUTH_RATE_LIMIT_ATTEMPTS=10
KIBA_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
KIBA_ACCOUNT_TOKEN_RATE_LIMIT_ATTEMPTS=5
KIBA_ACCOUNT_TOKEN_RATE_LIMIT_WINDOW_SECONDS=300

# EMAIL — development mode keeps links in a process-local test outbox and logs them locally.
KIBA_EMAIL_MODE=development
KIBA_VERIFICATION_TOKEN_HOURS=24
KIBA_PASSWORD_RESET_TOKEN_MINUTES=30
# KIBA_SMTP_HOST=
# KIBA_SMTP_PORT=587
# KIBA_SMTP_USERNAME=
# KIBA_SMTP_PASSWORD=
# KIBA_SMTP_FROM=
# KIBA_SMTP_STARTTLS=true

# SESSION CLEANUP
KIBA_BOT_SESSION_ACTIVE_TTL_SECONDS=21600
KIBA_BOT_SESSION_COMPLETE_TTL_SECONDS=1800
KIBA_PVP_WAITING_TTL_SECONDS=1800
KIBA_PVP_COMPLETE_TTL_SECONDS=900
KIBA_PVP_DISCONNECTED_TTL_SECONDS=7200

# Process-local private-room WebSocket safeguards.
KIBA_PVP_ACTION_RATE_LIMIT_ATTEMPTS=120
KIBA_PVP_ACTION_RATE_LIMIT_WINDOW_SECONDS=1
KIBA_PVP_MAX_WEBSOCKET_MESSAGE_BYTES=16384
KIBA_MULTIPLAYER_3_4_ENABLED=false
KIBA_DECK_VARIANTS_ENABLED=false

# Host-run backend alternative (Compose injects its own database service URL).
# KIBA_DATABASE_URL=postgresql+psycopg://kiba:password@localhost:5432/kiba
