# Local-only Docker Compose database values. Use external secrets in production.
KIBA_POSTGRES_DB=kiba
KIBA_POSTGRES_USER=kiba
KIBA_POSTGRES_PASSWORD=change-me-for-nonlocal-use

# Cookie/CSRF settings. Secure must be true when deployed behind HTTPS.
KIBA_AUTH_COOKIE_SECURE=false
KIBA_CSRF_TRUSTED_ORIGINS=http://localhost:14200,http://127.0.0.1:14200

# Host-run backend alternative (Compose injects its own database service URL).
# KIBA_DATABASE_URL=postgresql+psycopg://kiba:password@localhost:5432/kiba
