# Copy to a secret environment file outside version control. Replace every placeholder.
# APP
COMPOSE_PROJECT_NAME=kiba-production
KIBA_INGRESS_NETWORK=huskytracking_proxy
APP_ENV=production
KIBA_PUBLIC_BASE_URL=https://cyberdurak.com
KIBA_TRUSTED_HOSTS=cyberdurak.com,www.cyberdurak.com
KIBA_CSRF_TRUSTED_ORIGINS=https://cyberdurak.com,https://www.cyberdurak.com
KIBA_LOG_JSON=true

# DATABASE
KIBA_POSTGRES_DB=kiba
KIBA_POSTGRES_USER=kiba
KIBA_POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
KIBA_DATABASE_URL=postgresql+psycopg://kiba:REPLACE_WITH_URL_ENCODED_PASSWORD@database:5432/kiba

# AUTH / SECURITY
KIBA_AUTH_COOKIE_SECURE=true
KIBA_AUTH_SESSION_DAYS=30
KIBA_AUTH_SESSION_IDLE_DAYS=14
KIBA_AUTH_SESSION_TOUCH_MINUTES=15
KIBA_AUTH_RATE_LIMIT_ATTEMPTS=10
KIBA_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
KIBA_ACCOUNT_TOKEN_RATE_LIMIT_ATTEMPTS=5
KIBA_ACCOUNT_TOKEN_RATE_LIMIT_WINDOW_SECONDS=300

# EMAIL
KIBA_EMAIL_MODE=smtp
KIBA_SMTP_HOST=smtp.example.com
KIBA_SMTP_PORT=587
KIBA_SMTP_USERNAME=REPLACE_ME
KIBA_SMTP_PASSWORD=REPLACE_ME
KIBA_SMTP_FROM=Kiba <no-reply@example.com>
KIBA_SMTP_STARTTLS=true
KIBA_SMTP_TIMEOUT_SECONDS=10
KIBA_VERIFICATION_TOKEN_HOURS=24
KIBA_PASSWORD_RESET_TOKEN_MINUTES=30

# SESSION CLEANUP (one backend process / one application worker)
KIBA_BOT_SESSION_ACTIVE_TTL_SECONDS=21600
KIBA_BOT_SESSION_COMPLETE_TTL_SECONDS=1800
KIBA_PVP_WAITING_TTL_SECONDS=1800
KIBA_PVP_COMPLETE_TTL_SECONDS=900
KIBA_PVP_DISCONNECTED_TTL_SECONDS=7200
